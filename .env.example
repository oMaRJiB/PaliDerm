# Optional environment values; .env is not automatically loaded.
# run-local.sh selects these local paths unless explicitly overridden.
DATABASE=instance/encrypted/demo.sqlite3
UPLOAD_DIR=instance/encrypted/uploads
ENCRYPTION_KEY_FILE=instance/encryption.key
# Alternatively supply ENCRYPTION_KEY through your environment/secret manager.
# Set exactly one key source; do not put an actual key in this example.
APP_LOCALE=en
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_COUNT=12
# Administrator-selected saved model and its adjacent encoder/class JSON files.
# An explicitly empty MODEL_PATH disables inference. Never accept model paths from users.
MODEL_PATH=notebooks/SCIN_custom_model.keras
AI_TIMEOUT_SECONDS=60
# Unvalidated prototype uncertainty flag, not a clinical severity threshold.
AI_TRIAGE_DEMO_THRESHOLD=0.5
# Keep 0 for loopback HTTP; use 1 only with HTTPS.
SESSION_COOKIE_SECURE=0
# Optional independent session secret; otherwise private instance/session.key.
# This is a secret value, not a filename; never reuse the encryption key.
# SECRET_KEY=
# No public hosting; bind only to loopback.
